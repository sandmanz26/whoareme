# ── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/whoareyou
MONGODB_DB=whoareyou

# ── Auth ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=30d

# Separate key for hashing one-time tokens (verification, password reset).
TOKEN_HASH_SECRET=change-me-token-hash-secret-at-least-32-chars

# Salt for the daily viewer hash used to de-duplicate traffic.
VIEWER_HASH_SALT=change-me-viewer-salt

# ── CORS ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:9800,http://localhost:5173

# ── Uploads ─────────────────────────────────────────────────────────
MAX_THUMBNAIL_BYTES=1500000

# ── Mail ────────────────────────────────────────────────────────────
#   none        development only: token comes back in the response
#   log         written to the log instead of sent
#   resend      Resend HTTP API (MAIL_API_URL + MAIL_API_KEY)
#   nodemailer  Gmail / any SMTP server (SMTP_USER + SMTP_PASS)
#
#   Google: turn on 2-Step Verification, create an App Password at
#   https://myaccount.google.com/apppasswords, paste it into SMTP_PASS,
#   then set MAIL_TRANSPORT=nodemailer. For Gmail, MAIL_FROM must be the
#   same address as SMTP_USER (or an alias configured in that account).
MAIL_TRANSPORT=none
MAIL_FROM=whoareyou <hello@whoareyou.directory>

# Resend (MAIL_TRANSPORT=resend)
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=

# Gmail / SMTP (MAIL_TRANSPORT=nodemailer)
# Leave SMTP_HOST empty to use SMTP_SERVICE's well-known host and port;
# setting it means SMTP_PORT and SMTP_SECURE below are used as written.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where the SPA is served. Used to build the link inside the mail.
APP_BASE_URL=http://localhost:9800
