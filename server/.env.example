# ── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────
# Must be a replica set: publish runs in a transaction.
# Local: docker compose up -d  (see docker-compose.yml)
MONGODB_URI=mongodb://127.0.0.1:27017/whoareyou?replicaSet=rs0&directConnection=true
MONGODB_DB=whoareyou

# ── Auth ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Salt for the daily viewer hash used to de-duplicate traffic.
# Rotating this resets de-duplication; it never identifies a visitor.
VIEWER_HASH_SALT=change-me-viewer-salt

# ── CORS ────────────────────────────────────────────────────────────
# Comma separated. The SPA origin(s).
CORS_ORIGINS=http://localhost:9800,http://localhost:5173

# ── Uploads ─────────────────────────────────────────────────────────
MAX_THUMBNAIL_BYTES=1500000

# ── Mail ────────────────────────────────────────────────────────────
# Email verification gates publishing, so production refuses to start
# with MAIL_TRANSPORT=none.
#   none  development only — the token comes back in the response
#   log   written to the log instead of sent
#   http  JSON POST to MAIL_API_URL with a bearer key, body
#         {from, to, subject, text, html} (Resend's shape)
MAIL_TRANSPORT=none
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=
MAIL_FROM=whoareyou <hello@whoareyou.directory>

# Where the SPA is served. Used to build the link inside the mail.
APP_BASE_URL=http://localhost:9800
